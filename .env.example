# StreamHunter backend configuration (used from Phase 2 on).
# Copy to backend/.env and fill in real values. Never commit the real file.

# --- General ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./streamhunter.db
# Comma-separated extension origins allowed by CORS, e.g. chrome-extension://<your-extension-id>
CORS_ALLOWED_ORIGINS=chrome-extension://replace-with-your-extension-id

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me
# Fernet key for encrypting platform tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me

# --- Monitoring lease ---
MONITORING_LEASE_TTL_SECONDS=360

# --- Twitch (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback

# --- Kick (https://kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8000/api/v1/auth/kick/callback
# Public HTTPS base URL that Kick can reach for webhooks (e.g. a Cloudflare Tunnel).
# Leave empty to disable Kick chat monitoring; the capability is then reported as requires_configuration.
KICK_WEBHOOK_PUBLIC_URL=
