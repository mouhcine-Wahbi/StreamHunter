# StreamHunter backend configuration.
# Copy to backend/.env and fill in real values. Never commit the real file.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
# SQLite for local development; use postgresql://user:pass@host/db in production.
DATABASE_URL=sqlite:///./streamhunter.db
# Extra origins allowed by CORS (comma-separated). Extension pages are matched automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Accounts ---
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=336
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Security ---
# Fernet key for encrypting platform OAuth tokens at rest (required in production).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Browser monitoring ---
# Minimum lease length; effective TTL = max(this, 3 × heartbeat interval + 60 s).
MONITORING_LEASE_TTL_SECONDS=360
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15
# Never poll a streamer's status more often than this.
MIN_POLL_SECONDS=60
RETENTION_SWEEP_SECONDS=3600

# --- Media (post-stream analysis & export; needs FFmpeg installed) ---
# Per-user folders are created inside: <MEDIA_ROOT>/library/<user_id>/ and <MEDIA_ROOT>/exports/<user_id>/
MEDIA_ROOT=./media
MAX_UPLOAD_MB=4096
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_JOB_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_MEDIA_JOBS=1
# Subtitles (optional: pip install -r requirements-media.txt). Local speech-to-text model:
# tiny | base | small | medium | large-v3. Downloaded once on first use (base ≈ 145 MB).
WHISPER_MODEL=base
# WHISPER_MODEL_DIR=./media/models

# --- Twitch (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback

# --- Kick (https://kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8000/api/v1/auth/kick/callback
# Public HTTPS base URL Kick can reach for webhooks (e.g. a Cloudflare Tunnel).
# Leave empty to disable Kick chat monitoring (reported as requires_configuration).
KICK_WEBHOOK_PUBLIC_URL=
