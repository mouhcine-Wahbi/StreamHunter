{
  "manifest_version": 3,
  "name": "StreamHunter",
  "short_name": "StreamHunter",
  "description": "Find the moment. Create the clip. Highlight detection for Twitch and Kick livestreams.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StreamHunter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "notifications",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
