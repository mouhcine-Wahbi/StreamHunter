{
  "manifest_version": 3,
  "name": "StreamHunter",
  "short_name": "StreamHunter",
  "description": "Find the moment. Capture the clip. Automatic highlight clipping for Twitch, Kick and YouTube Live, entirely in your browser.",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "StreamHunter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "notifications",
    "activeTab",
    "tabCapture",
    "offscreen",
    "identity",
    "system.cpu",
    "system.memory"
  ],
  "commands": {
    "arm-recorder": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Use this tab as a StreamHunter recorder"
    }
  },
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://api.kick.com/*",
    "https://id.kick.com/*",
    "https://www.googleapis.com/youtube/v3/*",
    "https://www.youtube.com/feeds/*"
  ],
  "optional_host_permissions": ["https://api.anthropic.com/*", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
